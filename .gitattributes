# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source code files
*.py text eol=lf diff=python
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.iss text eol=crlf
*.toml text eol=lf

# Vector graphics
*.svg text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.whl binary
*.exe binary
*.zip binary
